# ComplyFood — local development environment
# Copy this file to .env and fill in your values

DATABASE_URL=******localhost:5432/complyfood
# Required by the production/Tailscale Docker backend; use a strong unique value.
POSTGRES_PASSWORD=
JWT_SECRET=change-me-in-development
PASSWORD_RESET_TOKEN_SALT=change-me-in-development
JWT_EXPIRES_IN=7d
PORT=4000
WEB_URL=http://localhost:3000
# WEB_URL supports comma-separated exact origins, e.g. your custom domain,
# your Vercel hostname, and http://localhost:3100 (no paths or trailing slashes).
STORAGE_DRIVER=s3
# For a backend on your Linux PC, STORAGE_DRIVER=local uses persistent Docker
# storage with docker-compose.tailscale.yml and needs no S3 service.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=complyfood
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Next.js web
# Browser-facing origin only (no /api/v1); required at frontend build time.
# For Funnel/Serve, replace with the HTTPS *.ts.net origin.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional server-side proxy origin; unset NEXT_PUBLIC_API_URL to use it.
# Requires a Next.js server with tailnet access and a rebuild when changed.
API_PROXY_URL=

# Full local, tailnet-only deployment: see docs/operations/deployment.md.
# Use docker-compose.prod.yml + docker-compose.tailscale.yml +
# docker-compose.tailnet-web.yml; set WEB_URL to your private HTTPS origin,
# STORAGE_DRIVER=local, and clear NEXT_PUBLIC_API_URL and legacy API_URL.
# The web override sets API_PROXY_URL=http://api:4000 at build time.
