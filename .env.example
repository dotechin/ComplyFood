# ComplyFood — local development environment
# Copy this file to .env and fill in your values

DATABASE_URL=******localhost:5432/complyfood
JWT_SECRET=change-me-in-development
PASSWORD_RESET_TOKEN_SALT=change-me-in-development
JWT_EXPIRES_IN=7d
PORT=4000
WEB_URL=http://localhost:3000
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=complyfood
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Next.js web
# Browser-facing origin only (no /api/v1); required at frontend build time.
# For Funnel/Serve, replace with the HTTPS *.ts.net origin.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional server-side proxy origin; unset NEXT_PUBLIC_API_URL to use it.
# Requires a Next.js server with tailnet access and a rebuild when changed.
API_PROXY_URL=
