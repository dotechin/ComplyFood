# ComplyFood web — local environment
# Copy this file to .env.local (same folder) and restart the dev server.
# Next.js reads env files from apps/web, not from the repository root.

# Browser-facing API origin only (no /api/v1, no trailing slash).
# Backend on this PC:            http://localhost:4000
# Backend via Tailscale Funnel:  https://<your-host>.<tailnet>.ts.net
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional server-side proxy origin. Leave empty when NEXT_PUBLIC_API_URL is set.
API_PROXY_URL=
