FROM node:20-alpine AS base
RUN npm install -g pnpm@9
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/
COPY packages/config/package.json ./packages/config/
RUN pnpm install --frozen-lockfile

FROM base AS dev
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY . .
# Build the shared package so `@complyfood/shared` resolves to dist/index.js.
# Needed here because migrations run via ts-node against the .ts entities,
# which import @complyfood/shared at runtime.
RUN pnpm --filter @complyfood/shared build
WORKDIR /app/apps/api
CMD ["pnpm", "start:dev"]

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY . .
# Compile the shared package to JS so it resolves at runtime.
# nest build (tsc) leaves `require("@complyfood/shared")` in the output,
# which Node resolves via the package's "main" -> dist/index.js.
RUN pnpm --filter @complyfood/shared build
WORKDIR /app/apps/api
RUN pnpm build

# Reuse the fully-resolved workspace (pnpm symlinks + built shared) instead of
# re-installing with npm, which cannot handle "workspace:*" dependencies.
FROM build AS production
ENV NODE_ENV=production
WORKDIR /app/apps/api
EXPOSE 4000
CMD ["node", "dist/main"]
